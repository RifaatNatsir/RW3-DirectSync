<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hrDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBackHr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_box_dark"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali ke dashboard"
            android:padding="10dp"
            android:scaleType="centerInside"
            app:tint="@color/on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detak Jantung"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvHrDetailSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemantauan kontinu · Hari ini"
                android:textSize="11sp"
                android:textColor="@color/on_surface_muted"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMeasureHr"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="88dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_coral"
            android:text="Ukur Ulang"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/heart_rate_coral" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/hrDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Hero Current HR Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_hr_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvHrHeroKicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DETAK SAAT INI · BELUM ADA DATA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:textColor="@color/hr_chart_line"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvHrHeroBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_mint"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Menunggu Data"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_mint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvHrHeroBpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginBottom="4dp"
                            android:text="BPM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvHrRhrValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="— BPM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_mint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HR Istirahat (RHR)"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_box_dark"
                        android:padding="10dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:id="@+id/tvHrStatMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- BPM"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Minimum"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_box_dark"
                        android:padding="10dp"
                        android:layout_marginHorizontal="4dp">

                        <TextView
                            android:id="@+id/tvHrStatAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- BPM"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rata-rata"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_box_dark"
                        android:padding="10dp"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:id="@+id/tvHrStatMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- BPM"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/hr_chart_line" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Puncak 24J"
                            android:textSize="11sp"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 24h Trend Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvHrChartTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Grafik Detak 24 Jam"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnWindow24h"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:paddingHorizontal="10dp"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_coral"
                            android:text="24 Jam"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/heart_rate_coral" />

                        <TextView
                            android:id="@+id/btnWindow7d"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:paddingHorizontal="10dp"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_surface"
                            android:text="7 Hari"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHrChartRangeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ketuk titik grafik untuk melihat waktu dan BPM"
                    android:textSize="11sp"
                    android:textColor="@color/on_surface_muted" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_box_dark"
                    android:padding="6dp">

                    <com.rw3.directsync.ui.custom.SparklineWaveView
                        android:id="@+id/hrDetailSparkline"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvHrChartEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Belum ada sampel detak jantung pada rentang waktu ini."
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_muted"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- HR Zones Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Zona Detak Jantung"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tvHrZonesTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 sampel"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_mint" />
                </LinearLayout>

                <!-- Zone 1: Aerobik -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Aerobik (125–145)"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <FrameLayout
                        android:id="@+id/trackZoneAerobic"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_bar_track">

                        <View
                            android:id="@+id/barZoneAerobic"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_bar_pill"
                            android:backgroundTint="@color/primary_emerald" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvZoneAerobicTime"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0 mnt"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <!-- Zone 2: Lemak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Lemak (104–124)"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <FrameLayout
                        android:id="@+id/trackZoneFat"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_bar_track">

                        <View
                            android:id="@+id/barZoneFat"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_bar_pill"
                            android:backgroundTint="@color/secondary_cyan" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvZoneFatTime"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0 mnt"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <!-- Zone 3: Pemanasan / Istirahat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Ringan (&lt;104)"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <FrameLayout
                        android:id="@+id/trackZoneWarmup"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_bar_track">

                        <View
                            android:id="@+id/barZoneWarmup"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_bar_pill"
                            android:backgroundTint="@color/sleep_deep" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvZoneWarmupTime"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0 mnt"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <!-- Zone 4: Anaerobik -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Anaerobik (146+)"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <FrameLayout
                        android:id="@+id/trackZoneAnaerobic"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_bar_track">

                        <View
                            android:id="@+id/barZoneAnaerobic"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_bar_pill"
                            android:backgroundTint="@color/hr_chart_line" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvZoneAnaerobicTime"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0 mnt"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </LinearLayout>

            <!-- Recent HR Logs Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Riwayat Pengukuran"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/btnExportHrCsv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="6dp"
                        android:text="Ekspor CSV ›"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_mint" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHrLogsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

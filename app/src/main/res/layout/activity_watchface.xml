<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/watchfaceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/watchfaceHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_wf_squircle_surface"
                android:clickable="true"
                android:contentDescription="Kembali"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingBottom="2dp"
                android:text="‹"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Watchface &amp; Wallpaper"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWatchConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Redmi Watch 3 · 390×450 AMOLED"
                    android:textColor="@color/primary_mint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRefreshWatchfacesTop"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_wf_squircle_surface"
                android:clickable="true"
                android:contentDescription="Muat Ulang Jam"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Muat Ulang"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/watchfaceScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- Card 1: Watch Studio Card (FigCraft Hero Preview + Toolbar + Pick Photo) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Redmi Watch 3 Bezel (180dp x 208dp curved AMOLED) -->
                <FrameLayout
                    android:id="@+id/frameWatchBezel"
                    android:layout_width="180dp"
                    android:layout_height="208dp"
                    android:background="@drawable/bg_watch_bezel"
                    android:clickable="true"
                    android:contentDescription="Pratinjau Layar Redmi Watch 3"
                    android:focusable="true"
                    android:padding="6dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="#000000"
                        app:cardCornerRadius="31dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgWatchPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Pratinjau Wallpaper"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Idle AMOLED Watch Face Preview (when no photo is picked yet) -->
                        <LinearLayout
                            android:id="@+id/layoutPlaceholderPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_watch_preview_idle"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvWatchPlaceholderDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="MIN 15 NOV"
                                android:textColor="@color/primary_mint"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWatchPlaceholderClock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="15:48"
                                android:textColor="@color/on_surface"
                                android:textSize="38sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWatchPlaceholderHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Pilih foto untuk latar jam"
                                android:textColor="#D1FAE5"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- 4-Pill Crop & Text Color Toolbar -->
                <LinearLayout
                    android:id="@+id/layoutPhotoControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomOut"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="− Zoom"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="9dp"
                        app:strokeColor="@color/outline_subtle"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomIn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="+ Zoom"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="9dp"
                        app:strokeColor="@color/outline_subtle"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetCrop"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="Reset"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="9dp"
                        app:strokeColor="@color/outline_subtle"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTextColor"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="Teks: Asli"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_mint"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pill_mint_bg"
                        app:cornerRadius="9dp"
                        app:strokeColor="@color/primary_mint"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Full-width Photo Picker Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickPhoto"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Pilih Foto dari Galeri"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_mint"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/surface_elevated"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/outline_subtle"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Card 2: Install & Transfer Card -->
            <LinearLayout
                android:id="@+id/cardInstallAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallToWatch"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:text="Pasang Wallpaper ke Jam"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/btn_emerald_bg"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/btn_emerald_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportWatchface"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="56dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Simpan berkas watchface (.bin)"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="0dp"
                        android:text=".BIN"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/outline_subtle"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInstallWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pilih foto terlebih dahulu untuk memasang wallpaper."
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Upload Progress Layout -->
                <LinearLayout
                    android:id="@+id/layoutTransferProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTransferStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Mengirim via SPP Ch5 (0 / 0 KB)"
                            android:textColor="@color/secondary_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTransferProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="0%"
                            android:textColor="@color/on_surface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBarTransfer"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_wf_progress" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTransferBytes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pastikan jam berada dekat HP"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelTransfer"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="Batal"
                            android:textAllCaps="false"
                            android:textColor="@color/btn_danger_stroke"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/btn_danger_bg"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Transfer Result Banner (Success / Error) -->
                <LinearLayout
                    android:id="@+id/layoutTransferResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_box_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgTransferResultIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/primary_mint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTransferResultTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status Pemasangan"
                            android:textColor="@color/on_surface"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTransferResultMsg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pesan hasil operasi..."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryTransfer"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Ulangi"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_mint"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Koleksi & Paket Watchface (Combined Import CTA + Installed List) -->
            <LinearLayout
                android:id="@+id/cardWatchfaceCollection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Koleksi &amp; Paket Watchface"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnImportPackage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Impor file paket watchface .bin atau .zip"
                        android:focusable="true"
                        android:gravity="center_vertical|end"
                        android:minHeight="32dp"
                        android:paddingHorizontal="4dp"
                        android:text="+ Impor .bin / .zip"
                        android:textColor="@color/secondary_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Selected Custom Package Box (shown when .bin / .face / .zip is imported) -->
                <LinearLayout
                    android:id="@+id/layoutImportedPackageInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_box_dark"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvImportedPackageName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Paket: --"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvImportedPackageDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ukuran: -- | MD5: --"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallImportedPackage"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:text="Pasang Paket Ini ke Jam"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/btn_cyan_bg"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/btn_cyan_stroke"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutEmptyWatchfaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvEmptyWatchfaces"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Belum ada daftar watchface dari jam.\nTekan Muat Ulang untuk membaca memori jam."
                        android:textColor="@color/on_surface_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshWatchfaceList"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="Baca Daftar Jam"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_mint"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/outline_subtle"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInstalledWatchfaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Card 4: Gaya Watchface & Efek Angka (Secondary Customization Drawer) -->
            <LinearLayout
                android:id="@+id/cardTextAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gaya Watchface &amp; Efek Teks"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutWatchfaceDesign"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Pilih desain jam"
                    app:endIconContentDescription="Pilih desain jam"
                    app:endIconDrawable="@drawable/ic_watchface_expand"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dropdownWatchfaceDesign"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:longClickable="false"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvTemplateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Handwriting · foto Anda dengan desain jam bawaan."
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickWatchfaceTemplate"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="Pilih berkas asli template"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_mint"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/surface_elevated"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/outline_subtle"
                    app:strokeWidth="1dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTextShadow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:text="Bayangan halus pada angka"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvShadowFeather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kehalusan bayangan · 3 px"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderShadowFeather"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="Kehalusan bayangan angka"
                    android:stepSize="1"
                    android:value="3"
                    android:valueFrom="1"
                    android:valueTo="6"
                    app:thumbColor="@color/primary_mint"
                    app:trackColorActive="@color/primary_mint"
                    app:trackColorInactive="@color/surface_elevated" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

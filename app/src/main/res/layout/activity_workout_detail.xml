                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:text="Aerobik"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_muted" />

                    <FrameLayout
                        android:id="@+id/trackWZoneAerobic"

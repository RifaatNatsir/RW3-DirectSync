<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengaturan Sistem &amp; Notifikasi"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Atur penerusan notifikasi serta kredensial pairing Redmi Watch 3."
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant" />

        <!-- Section: Notifikasi Pintar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="NOTIFIKASI PINTAR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/primary_mint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_box_dark"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/rowToggleAppNotifs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Teruskan notifikasi aplikasi (WhatsApp, SMS, dll)"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAppNotifs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/primary_mint"
                    app:trackTint="@color/surface_container_highest" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_subtle" />

            <LinearLayout
                android:id="@+id/rowToggleCallNotifs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Peringatan panggilan masuk"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCallNotifs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/primary_mint"
                    app:trackTint="@color/surface_container_highest" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_subtle" />

            <LinearLayout
                android:id="@+id/rowToggleWhitelistMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Gunakan filter whitelist (hanya aplikasi terpilih)"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWhitelistDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/primary_mint"
                    app:trackTint="@color/surface_container_highest" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Kredensial Jam -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KREDENSIAL REDMI WATCH 3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/secondary_cyan" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMacAddress"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="MAC Address Bluetooth"
            app:helperText="Format: AA:BB:CC:DD:EE:FF"
            app:helperTextTextColor="@color/on_surface_muted"
            app:boxStrokeColor="@color/secondary_cyan"
            app:hintTextColor="@color/secondary_cyan"
            app:errorEnabled="true"
            app:errorTextColor="@color/heart_rate_coral">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMacAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="17"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAuthKey"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Auth Key (32 karakter hex)"
            app:helperText="Kunci autentikasi 16-byte Xiaomi Wear"
            app:helperTextTextColor="@color/on_surface_muted"
            app:boxStrokeColor="@color/secondary_cyan"
            app:hintTextColor="@color/secondary_cyan"
            app:errorEnabled="true"
            app:errorTextColor="@color/heart_rate_coral">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAuthKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textNoSuggestions"
                android:maxLength="34"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWebhookCredentials"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Webhook Dispatcher URL (opsional)"
            app:helperText="Kosongkan jika belum memakai endpoint HTTP"
            app:helperTextTextColor="@color/on_surface_muted"
            app:boxStrokeColor="@color/secondary_cyan"
            app:hintTextColor="@color/secondary_cyan"
            app:errorEnabled="true"
            app:errorTextColor="@color/heart_rate_coral">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWebhookCredentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>


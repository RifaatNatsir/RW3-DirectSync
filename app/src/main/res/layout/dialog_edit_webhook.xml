<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ubah Endpoint Webhook"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Masukkan alamat server HTTP/HTTPS untuk menerima payload ekspor Room DB."
        android:textSize="12sp"
        android:textColor="@color/on_surface_variant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilWebhookUrl"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Endpoint Webhook"
        app:helperText="Contoh: http://192.168.1.100:8080/api/rw3/metrics"
        app:helperTextTextColor="@color/on_surface_muted"
        app:boxStrokeColor="@color/secondary_cyan"
        app:hintTextColor="@color/secondary_cyan"
        app:errorEnabled="true"
        app:errorTextColor="@color/heart_rate_coral">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWebhookUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="3"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>


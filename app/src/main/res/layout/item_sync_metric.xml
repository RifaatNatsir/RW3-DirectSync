<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_subcard">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/metricTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/metricStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_chip"
            android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <TextView android:id="@+id/metricValue" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/on_surface" />
    <TextView android:id="@+id/metricDataTime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/on_surface_variant" />
    <TextView android:id="@+id/metricSyncTime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="@color/on_surface_variant" />
    <TextView android:id="@+id/metricDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/on_surface_variant" />
    <Button android:id="@+id/btnRetryMetric" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:minHeight="48dp" android:text="Coba lagi" android:textSize="13sp"
        android:textAllCaps="false" android:textColor="@color/on_surface" android:background="@drawable/bg_button_subtle" app:backgroundTint="@null" />
</LinearLayout>
